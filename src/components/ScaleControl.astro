---
import "../styles/scale-control.css";
---

<section class="scale-control" aria-label="Solar system zoom control">
  <div class="scale-heading">
    <label for="solar-scale">Zoom</label>
    <output id="solar-scale-value" for="solar-scale" aria-live="polite">1×</output>
  </div>

  <input
    id="solar-scale"
    name="solar-scale"
    type="range"
    min="1"
    max="10"
    step="0.25"
    value="1"
    aria-label="Zoom into the solar system"
    aria-describedby="solar-scale-help"
  />

  <div class="scale-footer">
    <span>1×</span>
    <button id="reset-solar-scale" type="button">Reset zoom</button>
    <span>10×</span>
  </div>
  <p id="solar-scale-help">
    Zoom is centred on the Sun. Planet images grow more slowly than the orbits,
    so they remain recognisable without filling the screen.
  </p>
</section>

<script>
  import "../scripts/scale-control";
</script>
